{
  "manifest_version": 3,
  "name": "DeepGuard",
  "version": "1.0.0",
  "description": "Real-time deepfake detection for live video calls. Analyses facial manipulation risk during Google Meet and other video communication platforms.",

  "icons": {
    "16":  "assets/icons/icon16.png",
    "32":  "assets/icons/icon32.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "assets/icons/icon16.png",
      "48":  "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "DeepGuard"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "utils/constants.js",
        "utils/logger.js",
        "content/meet-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "tabs",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://meet.google.com/*"
  ],

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "web_accessible_resources": [
    {
      "resources": [
        "assets/models/*",
        "modules/*",
        "content/injected.js"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
